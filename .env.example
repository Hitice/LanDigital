# LanhouseDigital — variáveis do app Next.js.
# Copie para .env.local e preencha. NUNCA commite o .env.local.

# ─── IA (Anthropic / Claude) ────────────────────────────────────────────────
# Usada na revisão de contrato, no currículo e nos assistentes de atendimento.
# O SDK lê esta variável automaticamente.
ANTHROPIC_API_KEY=

# ─── Autenticação (Auth.js / NextAuth v5, login com Google) ─────────────────
# Gere o segredo com: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# true quando o app roda atrás de proxy (Cloud Run, etc.). Em dev pode ficar vazio.
AUTH_TRUST_HOST=true

# ─── Banco de dados (Supabase) ──────────────────────────────────────────────
# Service Role: só no servidor. Não exponha no cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Pagamentos (Asaas PIX / assinatura) ────────────────────────────────────
ASAAS_API_KEY=
# Sandbox (padrão) ou produção (https://api.asaas.com/v3).
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Opcional: reutiliza o cliente de recebimento já criado (evita recriar a cada boot).
ASAAS_CUSTOMER_ID=
# Token validado no header do webhook do Asaas.
ASAAS_WEBHOOK_TOKEN=

# ─── Negócio ────────────────────────────────────────────────────────────────
# CNPJ do recebedor nas cobranças (só dígitos).
BUSINESS_CNPJ=
BUSINESS_LEGAL_NAME=
# WhatsApp do balcão (formato internacional, só dígitos: DDI + DDD + número).
NEXT_PUBLIC_BUSINESS_WHATSAPP=

# ─── Desenvolvimento ────────────────────────────────────────────────────────
# Libera o acesso sem pagar. Só funciona fora de produção (NODE_ENV !== production).
PAYMENT_BYPASS=
